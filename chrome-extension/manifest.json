{
  "manifest_version": 3,
  "name": "Focus Secretary - 集中モード＋ポモドーロ＋秘書連動",
  "short_name": "Focus Secretary",
  "version": "1.1.0",
  "description": "タブ上限・サイトブロック・自動ポモドーロ・タブまたぎタイマー＋秘書AIと連動。仕事中に他を見ちゃう人向け。",
  "permissions": ["tabs", "storage", "notifications", "alarms", "webNavigation", "sidePanel", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
