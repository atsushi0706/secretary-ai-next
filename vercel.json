{
  "crons": [
    {
      "path": "/api/cron/checkin?slot=morning",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/checkin?slot=midday",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/checkin?slot=evening",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 11 * * 5"
    }
  ]
}
